<plist version="1.0">
<!-- ObfuscateUpdater runs with NO entitlements, and in particular without the App Sandbox:
     its whole job is to clear the quarantine the sandbox puts on the downloaded bundle and
     move that bundle into Applications, neither of which a sandboxed process may do. It has
     no network entitlement and no networking code (NoNetworkTests). -->
