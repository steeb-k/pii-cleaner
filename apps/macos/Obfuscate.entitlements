<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox, and deliberately NO network entitlement: logs never leave the Mac. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Only what the user picks in an open/save panel (legend files, sanitized output). -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- JavaScriptCore's JIT under the hardened runtime (Developer ID builds). Without
         this JSC silently falls back to its interpreter and large logs take far longer.
         It grants nothing beyond executable memory for the JIT; still no network. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
